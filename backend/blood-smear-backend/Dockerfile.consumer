FROM node:20-slim

# Install libvips for Sharp (DZI tile generation)
RUN apt-get update && apt-get install -y \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Also install sharp from the parent backend directory
RUN npm install sharp@0.34.4

# Copy application code
COPY . .

# Create temp directory for DZI processing
RUN mkdir -p /app/temp_dzi

# Start the Kafka consumer
CMD ["node", "Kafka/Consumer.js"]
